# Секреты: значения окружения, ключи доступа и профили аккаунтов (BOOT-006)
.env
.ssh/
.claude-accounts/
.codex-accounts/

# >>> daemons-services
# Данные демонов общего набора (postgres, opensearch, minio) — локальное состояние,
# не воспроизводимое из деклараций mise.toml
.data/
# <<< daemons-services

# Служебные файлы IDE и локальные настройки агента
.idea/
.claude/settings.local.json
__pycache__/

# Локальные данные интеграций: сессии ZCode, извлечения досок Miro
.zcode/
.miro/

# >>> domain-classifier
# Прогоны операции classify не коммитятся: карточка проекта содержит реальные данные,
# беклог прогона — их след (WRSP-022)
/backlog/classify/
/backlog/classify-project/
# Прогоны пакетной авто-классификации: карточки и итоговые файлы содержат реальные
# данные проектов, беклоги элементов — их след (WRSP-026)
/backlog/classify-project-auto/
# Прогоны пакетной карточной классификации: карточки и беклоги элементов содержат
# реальные данные проектов (WRSP-029)
/backlog/classify-card-auto/
# Входной промпт пакетного прогона с реальными карточками проектов — коммиту не подлежит
/docs/archive/prompts/batch-projects-for-cv-profile.md
# Окружение uv подпроекта CLI
tools/classifier/.venv/
# Локальный корневой pyproject.toml — настройка IDE владельца, не проектный файл
/pyproject.toml
# <<< domain-classifier

# >>> domain-layout
# Дерево доменной раскладки проектов: каталогы создаются из принятых прогонов classify
# утилитой tools/layout, реестр происхождения — в корне дерева (WRSP-038)
/projects/
# Окружение uv и кеши прогонов подпроекта раскладки
tools/layout/.venv/
tools/layout/.mypy_cache/
tools/layout/.pytest_cache/
tools/layout/.ruff_cache/
# <<< domain-layout
