# Git по SSH (задачи mise run init-ssh-key / init-ssh-config)
GIT_HOST=
GIT_USER=git

# >>> k3s-services
# Креды общего набора сервисов (helm-чарт deploy/workspace, задача mise run k3s-apply):
# пароль суперпользователя postgres, начальный пароль администратора opensearch,
# учётная запись minio. Значения — локальные, в git только имена
POSTGRES_PASSWORD=
OPENSEARCH_ADMIN_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# <<< k3s-services

# >>> domain-classifier
# Эндпоинт embeddings за прокси для tools/classifier: OpenAI-совместимый
# POST {EMBEDDINGS_BASE_URL}/embeddings. Значения — локальные, в git только имена.
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
# <<< domain-classifier
